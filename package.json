    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/tatyquebralayout/3D-of-the-Reutersv-rd-Triangle.git"
    },
    "bugs": {
        "url": "https://github.com/tatyquebralayout/3D-of-the-Reutersv-rd-Triangle/issues"
    },
    "homepage": "https://tatyquebralayout.github.io/3D-of-the-Reutersv-rd-Triangle/",
    "engines": {
        "node": ">=14.0.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ],
