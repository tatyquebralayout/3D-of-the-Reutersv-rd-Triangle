{
    "name": "3d-reutersvard-triangle",
    "version": "4.0.0",
    "description": "Interactive 3D visualization of the impossible Reutersvärd Triangle optical illusion using p5.js and WebGL",
    "main": "src/reutersvard-renderer.js",
    "type": "module",
    "scripts": {
        "dev": "vite --config build.config.js",
        "build": "vite build --config build.config.js",
        "preview": "vite preview --config build.config.js",
        "start": "npm run dev",
        "serve": "npx http-server . -p 5500 --cors"
    },
    "keywords": [
        "3d-graphics",
        "optical-illusion",
        "reutersvard-triangle",
        "penrose-triangle",
        "p5js",
        "webgl",
